# Copy this file to .env next to docker-compose.yml.
# The public homepage and guestbook work without OAuth credentials.
NAS_HTTP_PORT=8080
# For a LAN-only test, use your actual NAS address, e.g. http://192.168.0.10:8080
# For Google login, use your public HTTPS domain without a trailing slash.
APP_ORIGIN=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_MAP_CLIENT_ID=
# When using DSM reverse proxy, enter the public domain (no https:// or path).
# This also enables forwarded protocol handling for HTTPS redirects and forms.
VINEXT_TRUSTED_HOSTS=
